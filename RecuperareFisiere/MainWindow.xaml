<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperare Fișiere — Info PC Electric" Width="1120" Height="760" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8A96B0"/>
    <SolidColorBrush x:Key="CardBg" Color="#151C2C"/>
    <SolidColorBrush x:Key="Line" Color="#24304A"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" Padding="22,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#2563EB" Offset="0"/>
                  <GradientStop Color="#0891B2" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="#1B2436" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="10" Padding="12,8" Background="#111827" BorderBrush="#2C3A57" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,8,0" Foreground="#60A5FA" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="12" Padding="14,12" Background="#111827" BorderBrush="#2C3A57" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                  <Ellipse Stroke="#475569" StrokeThickness="2"/>
                  <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#60A5FA" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="DriveItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="#111827" BorderBrush="#24304A" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Padding="4,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1"><ContentPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="6" Background="#1E293B"/>
              <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#06B6D4" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#0F1524"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#24304A"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1E3A8A"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- antet -->
    <Grid Margin="28,22,28,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="14">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#06B6D4" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Recuperare Fișiere" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="PDF, Word, Excel, PowerPoint și poze — Info PC Electric" Style="{StaticResource Sub}"/>
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="10" Padding="12,7" Background="#0B2A1F" BorderBrush="#14532D" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#4ADE80" Margin="0,2,8,0"/>
          <TextBlock Text="Doar citire — discul sursă nu este modificat" Foreground="#86EFAC" FontSize="12.5"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- PAGINA 1: configurare -->
    <Grid x:Name="PageSetup" Grid.Row="1" Margin="28,0,28,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="400"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="1. Discul de pe care s-au pierdut fișierele" Style="{StaticResource H2}"/>
              <TextBlock Text="Alege HDD-ul de pe care ai copiat. Dacă partiția nu mai apare sau cere formatare, alege „Disc întreg”." Style="{StaticResource Sub}"/>
            </StackPanel>
            <Button x:Name="RefreshBtn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="12,0,0,0" Height="36" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
                <TextBlock Text="Reîmprospătează"/>
              </StackPanel>
            </Button>
          </Grid>
          <ListBox x:Name="DriveList" Foreground="#E6EAF2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DriveItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="44" Height="44" CornerRadius="11" Background="#1E293B">
                    <TextBlock Text="{Binding Icon}" FontSize="15" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8A96B0" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="7" Padding="9,4" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="2. Ce fișiere cauți" Style="{StaticResource H2}"/>
              <WrapPanel Margin="0,10,0,0">
                <ToggleButton x:Name="ChkPdf" Style="{StaticResource Chip}" IsChecked="True" Content="PDF"/>
                <ToggleButton x:Name="ChkWord" Style="{StaticResource Chip}" IsChecked="True" Content="Word"/>
                <ToggleButton x:Name="ChkJpg" Style="{StaticResource Chip}" IsChecked="True" Content="Poze JPG"/>
                <ToggleButton x:Name="ChkExcel" Style="{StaticResource Chip}" Content="Excel"/>
                <ToggleButton x:Name="ChkPpt" Style="{StaticResource Chip}" Content="PowerPoint"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="3. Mod de căutare" Style="{StaticResource H2}" Margin="0,0,0,10"/>
              <RadioButton x:Name="ModeQuick" Style="{StaticResource ModeCard}" GroupName="mode" IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Rapidă — cu numele originale" FontWeight="SemiBold" FontSize="13.5"/>
                  <TextBlock Text="Fișiere șterse de pe partiții NTFS, cu nume și foldere. Câteva minute." Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ModeDeep" Style="{StaticResource ModeCard}" GroupName="mode">
                <StackPanel>
                  <TextBlock Text="Profundă — sector cu sector" FontWeight="SemiBold" FontSize="13.5"/>
                  <TextBlock Text="Găsește și fișierele fără nume rămase pe disc. Pe un HDD mare poate dura ore." Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                </StackPanel>
              </RadioButton>
              <CheckBox x:Name="OptFree" IsChecked="True" Content="Profundă: doar spațiul liber (mai rapid)"/>
              <CheckBox x:Name="OptSmall" IsChecked="True" Content="Ignoră pozele foarte mici (iconițe, miniaturi sub 20 KB)"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="4. Unde salvez fișierele recuperate" Style="{StaticResource H2}"/>
              <TextBlock Text="Obligatoriu pe ALT disc decât cel scanat (SSD, stick, disc extern)." Style="{StaticResource Sub}"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border CornerRadius="10" Background="#0B1120" BorderBrush="#2C3A57" BorderThickness="1" Padding="10,0" Height="42">
                  <TextBlock x:Name="DestText" Text="Niciun folder ales" VerticalAlignment="Center" Foreground="#8A96B0" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0" Content="Alege…"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="WarnBox" CornerRadius="12" Padding="14,12" Background="#2A1E06" BorderBrush="#78350F" BorderThickness="1" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FBBF24" FontSize="15" Margin="0,1,0,0"/>
              <TextBlock x:Name="WarnText" Grid.Column="1" Foreground="#FCD34D" FontSize="12.5" TextWrapping="Wrap"/>
            </Grid>
          </Border>

          <Button x:Name="StartBtn" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/>
              <TextBlock Text="Începe căutarea"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- PAGINA 2: scanare -->
    <Grid x:Name="PageScan" Grid.Row="1" Margin="28,0,28,24" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Padding="26">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="ScanTitle" Text="Caut fișierele…" FontSize="22" FontWeight="Bold"/>
              <TextBlock x:Name="PhaseText" Text="" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PctText" Grid.Column="1" Text="0%" FontSize="40" FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center"/>
          </Grid>
          <ProgressBar x:Name="ProgBar" Minimum="0" Maximum="100" Value="0" Margin="0,18,0,20"/>
          <UniformGrid Columns="4">
            <StackPanel><TextBlock Text="VITEZĂ" Style="{StaticResource Sub}" FontSize="11"/><TextBlock x:Name="SpeedText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel><TextBlock Text="TIMP RĂMAS" Style="{StaticResource Sub}" FontSize="11"/><TextBlock x:Name="EtaText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel><TextBlock Text="PARCURS" Style="{StaticResource Sub}" FontSize="11"/><TextBlock x:Name="DoneText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
            <StackPanel><TextBlock Text="GĂSITE" Style="{StaticResource Sub}" FontSize="11"/><TextBlock x:Name="FoundText" Text="0" FontSize="17" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,3,0,0"/></StackPanel>
          </UniformGrid>
          <TextBlock x:Name="CountsText" Text="" Style="{StaticResource Sub}" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Găsite până acum" Style="{StaticResource H2}" Margin="0,0,0,10"/>
          <ListBox x:Name="LiveList" Foreground="#E6EAF2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Kind}" Foreground="{Binding KindColor}" FontWeight="SemiBold" FontSize="12.5"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12.5" Foreground="#8A96B0" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OpenDuringBtn" Style="{StaticResource Ghost}" Content="Deschide folderul de recuperare"/>
        <Button x:Name="StopBtn" Style="{StaticResource Ghost}" Margin="0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" Foreground="#F87171"/>
            <TextBlock Text="Oprește"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- PAGINA 3: rezultate -->
    <Grid x:Name="PageResults" Grid.Row="1" Margin="28,0,28,24" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="46" Height="46" CornerRadius="23" Background="#0B2A1F">
            <TextBlock x:Name="ResIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ResTitle" Text="" FontSize="19" FontWeight="Bold"/>
            <TextBlock x:Name="ResSub" Text="" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,14">
        <DataGrid x:Name="ResGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                  RowBackground="#151C2C" AlternatingRowBackground="#121929" Foreground="#E6EAF2" RowHeight="34"
                  SelectionMode="Extended" Margin="1">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="44">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Nume" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Tip" Width="96" SortMemberPath="Kind">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding KindColor}" FontWeight="SemiBold"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Mărime" Binding="{Binding SizeText}" Width="90" SortMemberPath="Size" IsReadOnly="True"/>
            <DataGridTextColumn Header="Folder original / poziție" Binding="{Binding Folder}" Width="2*" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Stare" Width="170" SortMemberPath="Status">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" x:Name="SelPanel">
          <Button x:Name="SelGoodBtn" Style="{StaticResource Ghost}" Content="Doar cele în stare bună"/>
          <Button x:Name="SelAllBtn" Style="{StaticResource Ghost}" Content="Toate"/>
          <Button x:Name="SelNoneBtn" Style="{StaticResource Ghost}" Content="Niciunul"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="NewBtn" Style="{StaticResource Ghost}" Content="Căutare nouă"/>
          <Button x:Name="DeepBtn" Style="{StaticResource Ghost}" Content="Încearcă și căutarea profundă"/>
          <Button x:Name="OpenBtn" Style="{StaticResource Ghost}" Content="Deschide folderul"/>
          <Button x:Name="RecoverBtn" Style="{StaticResource Primary}" Height="42">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/>
              <TextBlock x:Name="RecoverBtnText" Text="Recuperează selectate"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
