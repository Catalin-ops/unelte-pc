<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activează Sănătate PC Pro" Width="560" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#2C3A57"/>
      <Setter Property="CaretBrush" Value="#E6EAF2"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,22,26,22">
      <TextBlock Text="Activează versiunea Pro" FontSize="20" FontWeight="Bold"/>
      <Border x:Name="CurBox" CornerRadius="12" Padding="14,10" Margin="0,12,0,0" Background="#0B2A1F" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="CurTitle" FontWeight="Bold" Foreground="#4ADE80"/>
          <TextBlock x:Name="CurSub" FontSize="12" Foreground="#A7F3D0" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Lipește cheia de licență primită pe email" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="KeyBox" Height="92" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto"/>
      <Button x:Name="FileBtn" Content="…sau încarcă fișierul licenta.spc" HorizontalAlignment="Left" Margin="0,10,0,0"/>
      <CheckBox x:Name="OnStick" Content="Salvează licența lângă aplicație (pentru stick — merge pe orice PC)" Margin="0,16,0,0"/>
      <TextBlock x:Name="StickHint" FontSize="11.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="22,4,0,0"
                 Text="Debifat: licența rămâne doar pe acest calculator (folderul AppData)."/>
      <TextBlock x:Name="ErrText" Foreground="#F87171" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button x:Name="OkBtn" Content="Activează" Background="#2563EB" Margin="0,0,10,0"/>
        <Button x:Name="CancelBtn" Content="Închide" Margin="0,0,10,0"/>
        <Button x:Name="RemoveBtn" Content="Elimină licența" Visibility="Collapsed"/>
      </StackPanel>
      <Border CornerRadius="12" Padding="14,12" Margin="0,20,0,0" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Nu ai încă o licență?" FontWeight="SemiBold"/>
          <TextBlock Text="Pro se plătește ca abonament anual. Scrie-ne și primești oferta și cheia pe email." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,3,0,8"/>
          <Button x:Name="BuyBtn" Content="Cere ofertă pe email" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
