<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setări" Width="560" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#2C3A57"/>
      <Setter Property="CaretBrush" Value="#E6EAF2"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="15" Padding="13,6" Background="#1B2436" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,22,26,22">
      <TextBlock Text="Datele firmei pentru raport" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Apar în antetul raportului PDF dat clientului. Se salvează lângă licență (pe stick, dacă licența e acolo)." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Text="Numele firmei" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="CompanyBox"/>
      <TextBlock Text="Adresă" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="AddressBox"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Telefon" Style="{StaticResource Lbl}"/><TextBox x:Name="PhoneBox"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Email" Style="{StaticResource Lbl}"/><TextBox x:Name="EmailBox"/></StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Website" Style="{StaticResource Lbl}"/><TextBox x:Name="WebBox"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Tehnician (implicit)" Style="{StaticResource Lbl}"/><TextBox x:Name="TechBox"/></StackPanel>
      </Grid>
      <TextBlock Text="Logo (PNG sau JPG)" Style="{StaticResource Lbl}"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="160" Height="70" CornerRadius="10" Background="White" Padding="6">
          <Image x:Name="LogoImg" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button x:Name="LogoBtn" Content="Alege logo…" HorizontalAlignment="Left"/>
          <Button x:Name="LogoClear" Content="Fără logo" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
      <Border BorderBrush="#24304A" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Audit complet — valori implicite" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="Cât durează auditul pe un calculator și ce teste rulează. La pornirea auditului le poți schimba pentru fiecare client." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <WrapPanel x:Name="AuditMinPanel">
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="5 min" Tag="5"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="10 min" Tag="10"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="15 min" Tag="15"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="20 min" Tag="20"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="30 min" Tag="30"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="45 min" Tag="45"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="am" Content="60 min" Tag="60"/>
          </WrapPanel>
          <CheckBox x:Name="AuditStress" Content="Procesor sub sarcină + temperaturi" Margin="0,6,0,8"/>
          <CheckBox x:Name="AuditRam" Content="Test memorie RAM"/>
          <CheckBox x:Name="AuditDisk" Content="Citirea suprafeței discurilor"/>
          <CheckBox x:Name="AuditErr" Content="Erori de sistem în timpul testelor"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
        <Button x:Name="OkBtn" Content="Salvează" Background="#2563EB" Margin="0,0,10,0"/>
        <Button x:Name="CancelBtn" Content="Anulează"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
