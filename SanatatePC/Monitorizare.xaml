<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitorizare" Width="540" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#2C3A57"/>
      <Setter Property="CaretBrush" Value="#E6EAF2"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26,22,26,22">
      <TextBlock Text="Monitorizare zilnică" FontSize="20" FontWeight="Bold"/>
      <TextBlock Text="Calculatorul trimite de câteva ori pe zi starea componentelor și erorile din ultimele 24 de ore la serverul tău. Seara primești raportul pe instituții, iar dacă apare o problemă gravă, primești alertă imediat." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <Border x:Name="StateBox" Background="#1E293B" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock x:Name="StateTitle" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="StateSub" FontSize="12" Foreground="#C7CFDF" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Adresa serverului" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="ServerBox"/>
      <TextBlock Text="Codul instituției (din pagina serverului)" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="KeyBox"/>
      <TextBlock Text="Numele acestui calculator în raport (opțional, ex. Secretariat 1)" Style="{StaticResource Lbl}"/>
      <TextBox x:Name="LabelBox"/>
      <TextBlock x:Name="Msg" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
      <WrapPanel Margin="0,18,0,0">
        <Button x:Name="EnableBtn" Content="Activează monitorizarea" Background="#2563EB" Margin="0,0,10,10"/>
        <Button x:Name="SendBtn" Content="Trimite acum" Margin="0,0,10,10"/>
        <Button x:Name="DisableBtn" Content="Oprește" Margin="0,0,10,10"/>
        <Button x:Name="CancelBtn" Content="Închide" Margin="0,0,10,10"/>
      </WrapPanel>
      <TextBlock Text="Pentru multe calculatoare deodată: SanatatePC.exe --monitor-install --server=ADRESA --cheie=COD --eticheta=NUME (ca administrator, cu licența Pro lângă aplicație)." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
