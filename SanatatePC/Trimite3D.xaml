<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trimite raportul 3D" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="26,22,26,22">
    <TextBlock Text="Raportul 3D e gata" FontSize="20" FontWeight="Bold"/>
    <TextBlock x:Name="FileText" FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,16"/>
    <Button x:Name="WhatsBtn" Background="#14532D">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/><TextBlock Text="Trimite pe WhatsApp (copiază fișierul)"/></StackPanel>
    </Button>
    <Button x:Name="MailBtn">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/><TextBlock Text="Trimite pe e-mail (cu fișierul atașat)"/></StackPanel>
    </Button>
    <Button x:Name="OpenBtn">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/><TextBlock Text="Deschide raportul în browser"/></StackPanel>
    </Button>
    <Button x:Name="FolderBtn">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Margin="0,2,10,0"/><TextBlock Text="Arată fișierul în folder"/></StackPanel>
    </Button>
    <Border x:Name="InfoBox" Background="#11203A" CornerRadius="10" Padding="14,10" Margin="0,6,0,0" Visibility="Collapsed">
      <TextBlock x:Name="InfoText" FontSize="12.5" Foreground="#C7CFDF" TextWrapping="Wrap"/>
    </Border>
    <TextBlock x:Name="ModelWarn" Text="Atenție: această versiune a aplicației a fost construită fără modelul 3D, așa că raportul arată doar panourile cu date." FontSize="11.5" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
    <Button x:Name="CloseBtn" Content="Închide" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Width="120" Margin="0,14,0,0"/>
  </StackPanel>
</Window>
