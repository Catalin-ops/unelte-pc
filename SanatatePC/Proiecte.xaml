<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proiecte — Sănătate PC" Width="1080" Height="720" MinWidth="900" MinHeight="560" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#2C3A57"/>
      <Setter Property="CaretBrush" Value="#E6EAF2"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Item" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="#111827" BorderBrush="#24304A" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#172554"/><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="24,20,24,20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="16" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Proiecte (instituții)" FontSize="17" FontWeight="Bold"/>
          <TextBlock x:Name="WhereText" FontSize="11.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,3,0,10"/>
          <TextBlock Text="Proiect nou — numele instituției" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NewName"/>
            <Button x:Name="NewBtn" Grid.Column="1" Content="Creează" Background="#2563EB" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Text="Proiectele existente" Style="{StaticResource Lbl}" Margin="0,16,0,6"/>
        </StackPanel>
        <Button x:Name="FolderBtn" DockPanel.Dock="Bottom" Content="Deschide folderul proiectelor" Margin="0,10,0,0"/>
        <ListBox x:Name="ProjList" Background="Transparent" BorderThickness="0" Foreground="#E6EAF2" ItemContainerStyle="{StaticResource Item}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="#8A96B0" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="ProjTitle" Text="Alege sau creează un proiect" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ProjSub" FontSize="12.5" Foreground="#8A96B0" Margin="0,3,0,0"/>
      </StackPanel>

      <Border x:Name="AddBox" Grid.Row="1" Background="#151C2C" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,14" IsEnabled="False">
        <StackPanel>
          <TextBlock Text="Adaugă calculatorul acesta în proiect" FontSize="14.5" FontWeight="Bold"/>
          <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Nume PC (obligatoriu)" Style="{StaticResource Lbl}"/><TextBox x:Name="PcLabel"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Birou / sală" Style="{StaticResource Lbl}"/><TextBox x:Name="PcRoom"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="Utilizator" Style="{StaticResource Lbl}"/><TextBox x:Name="PcUser"/></StackPanel>
          </Grid>
          <TextBlock Text="Observații (ce ai constatat tu, opțional)" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="PcNotes" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="AddBtn" Background="#2563EB">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
                <TextBlock Text="Salvează PC-ul în proiect"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="AddInfo" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12.5" Foreground="#4ADE80"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="16" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Calculatoarele din proiect" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,10"/>
          <ListBox x:Name="PcList" Background="Transparent" BorderThickness="0" Foreground="#E6EAF2" ItemContainerStyle="{StaticResource Item}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="#8A96B0" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="1" CornerRadius="7" Padding="9,3" Background="{Binding StatusBg}" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="Bold"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Row="3" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="DelBtn" Content="Șterge PC-ul selectat" Margin="0,0,10,0" IsEnabled="False"/>
          <Button x:Name="CloseBtn" Content="Închide"/>
        </StackPanel>
        <Button x:Name="ReportBtn" Grid.Column="1" Background="#2563EB" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
            <TextBlock Text="Raport PDF pentru instituție"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
