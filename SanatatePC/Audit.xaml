<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit complet — Sănătate PC" Width="780" Height="760" MinWidth="680" MinHeight="620" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="#1B2436"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- butoane-pastila pentru durata -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C7CFDF"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="17" Padding="16,7" Background="#1B2436" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="6" Background="#1E293B"/>
              <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#06B6D4" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="26,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Audit complet" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Rulează teste reale pe durata aleasă: procesorul sub sarcină cu temperaturi, memoria RAM, citirea suprafeței discurilor și erorile de sistem. Durata se împarte între testele bifate; în raport apare durata reală." FontSize="12.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- alegerea duratei si a testelor -->
    <Border x:Name="SetupBox" Grid.Row="1" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Durată pe calculator" FontSize="12" Foreground="#8A96B0" Margin="0,0,0,8"/>
        <WrapPanel x:Name="MinPanel">
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="5 min" Tag="5"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="10 min" Tag="10"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="15 min" Tag="15"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="20 min" Tag="20"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="30 min" Tag="30"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="45 min" Tag="45"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="m" Content="60 min" Tag="60"/>
        </WrapPanel>
        <TextBlock Text="Teste" FontSize="12" Foreground="#8A96B0" Margin="0,8,0,10"/>
        <CheckBox x:Name="ChkStress" Content="Procesor sub sarcină + temperaturi (găsește răcirea înfundată și scăderea frecvenței)"/>
        <CheckBox x:Name="ChkRam" Content="Test memorie RAM (atâtea treceri câte încap în timp)"/>
        <CheckBox x:Name="ChkDisk" Content="Citirea suprafeței discurilor (doar citire; găsește zonele lente și sectoarele defecte)"/>
        <CheckBox x:Name="ChkErr" Content="Erori de sistem apărute în timpul testelor (WHEA, disc, driver video)"/>
        <TextBlock x:Name="SetupHint" FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- desfasurare -->
    <Border Grid.Row="2" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="StateTitle" Text="Gata de pornire" FontSize="17" FontWeight="Bold"/>
            <TextBlock x:Name="PhaseText" FontSize="12.5" Foreground="#8A96B0" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock x:Name="ClockText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Right"/>
            <TextBlock x:Name="ClockSub" Text="" FontSize="11.5" Foreground="#8A96B0" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="Prog" Grid.Row="1" Minimum="0" Maximum="100" Margin="0,14,0,14"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="StepList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#0F1524" BorderBrush="#24304A" BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      <TextBlock Text="{Binding Result}" FontSize="12" Foreground="#C7CFDF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="9" Padding="10,3" VerticalAlignment="Top" Margin="10,0,0,0" Background="{Binding StateBg}">
                      <TextBlock Text="{Binding State}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding StateColor}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FootText" VerticalAlignment="Center" FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,0,12,0"
                 Text="Calculatorul nu intră în repaus cât rulează auditul. Închide programele deschise înainte de pornire."/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CloseBtn" Content="Închide" Margin="0,0,10,0"/>
        <Button x:Name="StartBtn" Content="Pornește auditul" Background="#2563EB"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
