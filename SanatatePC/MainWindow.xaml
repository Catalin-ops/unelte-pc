<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sănătate PC — Info PC Electric" Width="1320" Height="820" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#8A96B0"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#151C2C"/>
      <Setter Property="BorderBrush" Value="#24304A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Width" Value="218"/>
      <Setter Property="Background" Value="#111827"/>
      <Setter Property="BorderBrush" Value="#24304A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
    <Style x:Key="TileLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <Style x:Key="TileSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="#1B2436" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DiskItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="#111827" BorderBrush="#24304A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#172554"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#0F1524"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#24304A"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1E3A8A"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9" Margin="0,0,0,3">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#18213A"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter Margin="0,0,0,12"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="18,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#2563EB" Offset="0"/><GradientStop Color="#0891B2" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Grid Margin="28,22,28,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="48" Height="48" CornerRadius="14">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#059669" Offset="0"/><GradientStop Color="#06B6D4" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="Sănătate PC" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="Toate componentele calculatorului, modelul și starea lor — Info PC Electric" FontSize="12.5" Foreground="#8A96B0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="LicBadge" CornerRadius="10" Padding="12,7" Background="#1E293B" VerticalAlignment="Center" Cursor="Hand">
          <StackPanel>
            <TextBlock x:Name="LicTitle" Text="Versiunea Free" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8"/>
            <TextBlock x:Name="LicSub" Text="Activează Pro pentru toate detaliile" FontSize="11" Foreground="#8A96B0"/>
          </StackPanel>
        </Border>
        <Button x:Name="ProBtn" Style="{StaticResource Primary}" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
            <TextBlock Text="Activează Pro"/>
          </StackPanel>
        </Button>
        <Button x:Name="ProjectsBtn" Style="{StaticResource Ghost}" ToolTip="Proiecte: salvează mai multe calculatoare dintr-o instituție și fă raportul comun (Pro)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
            <TextBlock Text="Proiecte"/>
          </StackPanel>
        </Button>
        <Button x:Name="RefreshBtn" Style="{StaticResource Ghost}" ToolTip="Citește din nou toate componentele">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
            <TextBlock Text="Reîmprospătează"/>
          </StackPanel>
        </Button>
        <Button x:Name="SaveBtn" Style="{StaticResource Ghost}" ToolTip="Raport PDF pentru client (Pro)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/>
            <TextBlock Text="Raport PDF"/>
          </StackPanel>
        </Button>
        <Button x:Name="SettingsBtn" Style="{StaticResource Ghost}" ToolTip="Datele firmei și logo-ul pentru raport">
          <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="28,0,28,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="10">
        <ListBox x:Name="NavList" Foreground="#E6EAF2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#93C5FD" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Ellipse Grid.Column="2" Width="9" Height="9" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="8,0,2,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid x:Name="LoadingPanel" Grid.Column="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#3B82F6" HorizontalAlignment="Center"/>
          <TextBlock x:Name="LoadingText" Text="Citesc componentele…" FontSize="16" Foreground="#8A96B0" Margin="0,14,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="SummaryPage" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <Border CornerRadius="20" Padding="28,24" Margin="0,0,0,16" BorderBrush="#24304A" BorderThickness="1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#172554" Offset="0"/><GradientStop Color="#111827" Offset="0.7"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="170" Height="170" HorizontalAlignment="Left">
                <Ellipse Width="156" Height="156" Stroke="#1E293B" StrokeThickness="14"/>
                <Path x:Name="SumRing" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="SumScore" Text="—" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="scor general" FontSize="11.5" Foreground="#8A96B0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border x:Name="SumPill" CornerRadius="9" Padding="12,5" HorizontalAlignment="Left">
                  <TextBlock x:Name="SumPillText" FontSize="13" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="SumTitle" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="SumSub" FontSize="13" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="SumIssues" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0" Foreground="#C7CFDF"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="FreeBanner" CornerRadius="14" Padding="18,14" Margin="0,0,0,16" Background="#0F1E3D" BorderBrush="#2563EB" BorderThickness="1" Cursor="Hand" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="FreeTitle" Text="Folosești versiunea Free" FontSize="14.5" FontWeight="Bold"/>
                <TextBlock x:Name="FreeText" Text="Vezi verdictul și modelele componentelor. Cu Pro primești toate detaliile, SMART, temperaturi, stabilitate, monitorizare live și raport PDF cu logo-ul firmei." FontSize="12.5" Foreground="#93C5FD" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Activează  &#x203A;" FontSize="13.5" FontWeight="SemiBold" Foreground="#60A5FA" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
          </Border>
          <ListBox x:Name="TileList" Background="Transparent" BorderThickness="0" Foreground="#E6EAF2"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="16" Padding="16,14" Margin="0,0,12,12">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/><Setter TargetName="Bd" Property="Background" Value="#18213A"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="{Binding StatusBg}">
                      <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="2" CornerRadius="7" Padding="8,3" Background="{Binding StatusBg}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="#AEB8CC" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="LivePage" Grid.Column="2" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="2,0,0,14">
          <TextBlock Text="Monitorizare live" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Încărcarea și temperaturile actualizate în fiecare secundă. Pornește un program greu (joc, randare) ca să vezi cum se comportă răcirea." FontSize="12.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <UniformGrid x:Name="LiveGrid" Grid.Row="1" Columns="3" Rows="2" Margin="0,0,-12,-12"/>
        <Border x:Name="LiveLock" Grid.Row="1" Background="#E60E131F" Visibility="Collapsed" Cursor="Hand">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#60A5FA" HorizontalAlignment="Center"/>
            <TextBlock Text="Monitorizarea live e în versiunea Pro" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Grafice în timp real pentru procesor, memorie, placa video, discuri și temperaturi. Apasă aici pentru a activa Pro." FontSize="13" Foreground="#93C5FD" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="GenericPage" Grid.Column="2" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="2,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="PageDesc" FontSize="12.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
          <Button x:Name="ActionBtn" Grid.Column="1" Style="{StaticResource Primary}" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
        <ListBox x:Name="CardList" Foreground="#E6EAF2" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CardItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="16" Padding="20,18" Cursor="{Binding Hand}">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="#8A96B0" Margin="0,3,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Border CornerRadius="8" Padding="10,4" Background="#1E293B" Margin="0,0,8,0" Visibility="{Binding BadgeVisibility}">
                          <TextBlock Text="{Binding Badge}" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border CornerRadius="8" Padding="10,4" Background="{Binding StatusBg}">
                          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="Bold"/>
                        </Border>
                      </StackPanel>
                    </Grid>
                    <Border Visibility="{Binding LockVisibility}" Background="#0F1524" BorderBrush="#24304A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" Margin="0,2,10,0"/>
                        <TextBlock Text="Detaliile complete sunt în versiunea Pro — apasă pentru activare" FontSize="12.5" Foreground="#93C5FD"/>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Props}" Margin="0,10,0,0" Visibility="{Binding PropsVisibility}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Width="230" Margin="0,8,14,0">
                            <TextBlock Text="{Binding Key}" FontSize="11.5" Foreground="#8A96B0"/>
                            <TextBlock Text="{Binding Value}" Foreground="{Binding ValueColor}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Visibility="{Binding NotesVisibility}" Background="#0F1524" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                      <TextBlock Text="{Binding Notes}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Foreground="#C7CFDF"/>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid x:Name="DiskPage" Grid.Column="2" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- lista discuri -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Discuri" Style="{StaticResource H2}"/>
          <ListBox x:Name="DiskList" Foreground="#E6EAF2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DiskItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="#8A96B0" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right">
                    <Border CornerRadius="7" Padding="9,3" Background="{Binding HealthBg}" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding HealthText}" Foreground="{Binding HealthColor}" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding ListTemp}" Foreground="{Binding TempColor}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- detalii -->
      <ScrollViewer x:Name="Detail" Grid.Column="2" VerticalScrollBarVisibility="Auto" >
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="24">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="150" Height="150" HorizontalAlignment="Left">
                <Ellipse Width="136" Height="136" Stroke="#1E293B" StrokeThickness="12"/>
                <Path x:Name="RingArc" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding HealthColor}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ScoreText}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{Binding HealthColor}"/>
                  <TextBlock Text="scor sănătate" FontSize="11" Foreground="#8A96B0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Border CornerRadius="9" Padding="12,5" Background="{Binding HealthBg}">
                    <TextBlock Text="{Binding HealthText}" Foreground="{Binding HealthColor}" FontSize="16" FontWeight="Bold"/>
                  </Border>
                  <Border CornerRadius="9" Padding="10,5" Background="#1E293B" Margin="8,0,0,0">
                    <TextBlock Text="{Binding TypeBadge}" Foreground="#93C5FD" FontSize="13" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="#8A96B0" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Verdict}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20"/>
              </StackPanel>
            </Grid>
          </Border>

          <WrapPanel x:Name="DiskTiles" Margin="0,0,-12,0">
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="TEMPERATURĂ" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding TempText}" Foreground="{Binding TempColor}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding TempMaxText}" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="VIAȚĂ RĂMASĂ (SSD)" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding LifeText}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="estimată de controlerul discului" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="SECTOARE DEFECTE / ERORI" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding ErrorsText}" Foreground="{Binding ErrorsColor}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding ErrorsSub}" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="ORE DE FUNCȚIONARE" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding HoursText}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding HoursSub}" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="PORNIRI" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding CyclesText}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="de câte ori a fost alimentat" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="DATE SCRISE" Style="{StaticResource TileLabel}"/>
                <TextBlock Text="{Binding WrittenText}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="total pe toată viața discului" Style="{StaticResource TileSub}"/>
              </StackPanel>
            </Border>
          </WrapPanel>

          <Border x:Name="DiskLock" Background="#151C2C" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,12" Visibility="Collapsed" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="&#xE72E;  Detaliile discului sunt în versiunea Pro" FontFamily="Segoe UI, Segoe MDL2 Assets" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="Temperatura, viața rămasă, sectoarele defecte, orele de funcționare și tabelul SMART complet. Apasă aici pentru a activa Pro." FontSize="12.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="DiskReasons" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Ce am găsit" Style="{StaticResource H2}"/>
              <TextBlock Text="{Binding ReasonsText}" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
          </Border>

          <Border x:Name="DiskInfo" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Detalii" Style="{StaticResource H2}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Număr serie" Foreground="#8A96B0" Margin="0,3"/>
                <TextBlock Grid.Column="1" Text="{Binding Serial}" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Firmware" Foreground="#8A96B0" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Interfață" Foreground="#8A96B0" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Interface}" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="Capacitate" Foreground="#8A96B0" Margin="0,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" Margin="0,3"/>
                <TextBlock Grid.Row="4" Text="Sursa datelor" Foreground="#8A96B0" Margin="0,3"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SourceText}" TextWrapping="Wrap" Margin="0,3"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="DiskSmart" Style="{StaticResource Card}" Padding="0">
            <StackPanel>
              <TextBlock Text="Atribute SMART (pentru tehnicieni)" Style="{StaticResource H2}" Margin="20,18,20,10"/>
              <DataGrid x:Name="AttrGrid" ItemsSource="{Binding Attributes}" AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                        RowBackground="#151C2C" AlternatingRowBackground="#121929" Foreground="#E6EAF2" RowHeight="30"
                        CanUserAddRows="False" Margin="1,0,1,10" ScrollViewer.CanContentScroll="False"
                        VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                  <DataGridTextColumn Header="Atribut" Binding="{Binding Name}" Width="300"/>
                  <DataGridTextColumn Header="Curent" Binding="{Binding Current}" Width="70"/>
                  <DataGridTextColumn Header="Cel mai rău" Binding="{Binding Worst}" Width="90"/>
                  <DataGridTextColumn Header="Prag" Binding="{Binding Threshold}" Width="60"/>
                  <DataGridTextColumn Header="Valoare" Binding="{Binding RawText}" Width="260"/>
                  <DataGridTemplateColumn Header="Stare" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
