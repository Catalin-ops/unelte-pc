<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generator Licențe — Sănătate PC" Width="720" Height="720" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0E131F" FontFamily="Segoe UI" Foreground="#E6EAF2"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1120"/>
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="BorderBrush" Value="#2C3A57"/>
      <Setter Property="CaretBrush" Value="#E6EAF2"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8A96B0"/>
      <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Padding="16,0" Background="{TemplateBinding Background}" BorderBrush="#2C3A57" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Background" Value="#1B2436"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6EAF2"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="Generator Licențe" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Emite chei Pro pentru Sănătate PC. Păstrează acest program și cheia privată doar la tine." FontSize="12.5" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,3,0,0"/>

      <Border Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock x:Name="KeyStatus" Text="Cheia privată nu e încărcată" FontWeight="SemiBold" Foreground="#FBBF24"/>
          <TextBlock Text="Fișierul cheie_privata_SanatatePC.txt e căutat lângă acest program. Îl poți alege și manual." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,4,0,10"/>
          <Button x:Name="LoadKeyBtn" Content="Alege fișierul cu cheia privată…" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="Numele clientului (apare în aplicație și pe rapoarte)" Style="{StaticResource Lbl}" Margin="0,0,0,4"/>
          <TextBox x:Name="NameBox"/>
          <TextBlock Text="Email client" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="EmailBox"/>
          <TextBlock Text="Valabilitate" Style="{StaticResource Lbl}"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Y1" Content="1 an" IsChecked="True" GroupName="v"/>
            <RadioButton x:Name="M1" Content="1 lună (probă)" GroupName="v"/>
            <RadioButton x:Name="Life" Content="Fără expirare" GroupName="v"/>
          </StackPanel>
          <Button x:Name="GenBtn" Content="Generează cheia" Background="#2563EB" BorderBrush="#2563EB" Margin="0,18,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <Border x:Name="OutCard" Background="#151C2C" BorderBrush="#24304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="OutInfo" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBox x:Name="OutBox" IsReadOnly="True" TextWrapping="Wrap" Height="90" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12.5"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CopyBtn" Content="Copiază cheia" Margin="0,0,10,0"/>
            <Button x:Name="SaveBtn" Content="Salvează licenta.spc…"/>
          </StackPanel>
          <TextBlock Text="Trimite clientului fie cheia (o lipește în aplicație la „Activează Pro”), fie fișierul licenta.spc (îl pune lângă SanatatePC.exe pe stick)." FontSize="12" Foreground="#8A96B0" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
